generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String?
  dataCriacao DateTime @default(now())

  // Acompanha a ordenação da listagem (paginação por cursor/keyset)
  @@index([dataCriacao, id])
}